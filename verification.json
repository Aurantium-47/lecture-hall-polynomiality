{
  "scope": "Finite exact checks; the paper supplies the proof for all indices.",
  "environment": {
    "python": "3.8.3",
    "sympy": "1.6.1"
  },
  "symbolic": {
    "max_index": 10,
    "equations_checked": 10,
    "all_toeplitz_equations_passed": true,
    "monomial_counts_ell_1_onward": [
      1,
      1,
      2,
      4,
      8,
      16,
      32,
      64,
      128,
      256
    ],
    "first_five": [
      "y1",
      "y1**2*y2",
      "y1**3*y2**2 + y1**2*y2**2*y3",
      "y1**4*y2**3 + 2*y1**3*y2**3*y3 + y1**2*y2**3*y3**2 + y1**2*y2**2*y3**2*y4",
      "y1**5*y2**4 + 3*y1**4*y2**4*y3 + 3*y1**3*y2**4*y3**2 + 2*y1**3*y2**3*y3**2*y4 + y1**2*y2**4*y3**3 + 2*y1**2*y2**3*y3**3*y4 + y1**2*y2**2*y3**3*y4**2 - y1**2*y2**2*y3**2*y4**2*y5"
    ]
  },
  "integer": {
    "max_index": 40,
    "cases": [
      {
        "name": "all_one",
        "formula": "y_j = 1"
      },
      {
        "name": "increasing",
        "formula": "y_j = j"
      },
      {
        "name": "alternating_signed",
        "formula": "y_j = (-1)^j * (j mod 5 + 1)"
      }
    ],
    "equations_checked": 120,
    "all_toeplitz_equations_passed": true
  },
  "composition": {
    "max_mu_index": 12,
    "max_ell_index": 13,
    "all_coefficients_agree": true,
    "monomial_counts_mu_1_onward": [
      1,
      2,
      4,
      8,
      16,
      32,
      64,
      128,
      256,
      512,
      1024,
      2048
    ]
  }
}
